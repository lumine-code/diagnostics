{
  // Packages > Diagnostics menu follows the order of use.
  "menu": [
    {
      "label": "View",
      "submenu": [
        {
          "label": "Toggle View",
          "submenu": [
            {
              "label": "Diagnostics",
              "command": "diagnostics:toggle",
              "group": "panels",
              "order": 10
            }
          ]
        }
      ]
    },
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Diagnostics",
          "submenu": [
            { "label": "Toggle Diagnostics", "command": "diagnostics:toggle" },
            { "label": "Toggle Diagnostics Focus", "command": "diagnostics:toggle-focus" },
            { "type": "separator" },
            { "label": "Next Diagnostic", "command": "diagnostics:next" },
            { "label": "Previous Diagnostic", "command": "diagnostics:previous" },
            { "label": "Clear All Diagnostics", "command": "diagnostics:clear" },
            { "type": "separator" },
            { "label": "Show Active File Diagnostics", "command": "diagnostics:file-mode" },
            { "label": "Show Project Diagnostics", "command": "diagnostics:project-mode" }
          ]
        }
      ]
    }
  ],
  // Right-click a row to take its text. Declared here rather than added from
  // the panel's constructor: a menu file is registered once for the package,
  // where lumine.contextMenu.add never de-duplicates.
  "context-menu": {
    ".diagnostics .diagnostics-row": [
      { "type": "separator" },
      { "label": "Copy Description", "command": "diagnostics:copy-description" },
      { "label": "Copy Details", "command": "diagnostics:copy-details" },
      { "type": "separator" }
    ]
  }
}
